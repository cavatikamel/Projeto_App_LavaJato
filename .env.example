# Browser-safe variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Temporary login gate (build-time only, public no bundle - substituir por Supabase Auth).
# Sem estes valores o login fica desativado. Nao versione o .env real (ja esta no .gitignore).
VITE_LOGIN_USERNAME=your-temporary-login-user
VITE_LOGIN_PASSWORD=your-temporary-login-password

# Server-only variables
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
